#: worker/send-account-deleted-email.tsx:29
msgid "Hvala što ste koristili AutoKPO. Prijatno!"
msgstr "Thank you for using AutoKPO. Goodbye!"

#: worker/send-otp-email.tsx:32
msgid "Kod važi 5 minuta. Ako niste tražili ovaj kod, ignorišite ovu poruku."
msgstr "This code is valid for 5 minutes. If you didn't request this code, please ignore this message."

#: worker/send-otp-email.tsx:29
msgid "Koristite sledeći kod za prijavu na vaš AutoKPO nalog:"
msgstr "Use the following code to sign in to your AutoKPO account:"

#: worker/send-otp-email.tsx:22
#: worker/send-otp-email.tsx:27
msgid "Vaš AutoKPO kod za prijavu"
msgstr "Your AutoKPO sign-in code"

#: worker/send-account-deleted-email.tsx:21
#: worker/send-account-deleted-email.tsx:25
msgid "Vaš AutoKPO nalog je obrisan"
msgstr "Your AutoKPO account has been deleted"

#: worker/send-account-deleted-email.tsx:27
msgid "Vaš AutoKPO nalog je obrisan. Nalog i sinhronizovani podaci povezani sa ovom email adresom su trajno uklonjeni."
msgstr "Your AutoKPO account has been deleted. The account and synchronized data associated with this email address have been permanently removed."
