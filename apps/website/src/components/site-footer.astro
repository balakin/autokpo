---
import githubBlackUrl from '../assets/github-black.svg?url';
import githubWhiteUrl from '../assets/github-white.svg?url';
import type { LandingContent } from '../i18n/landing';

interface Props {
  content: LandingContent;
  legalUrls: { privacy: string; terms: string };
}

const { content, legalUrls } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="wordmark">AutoKPO</span>
      <span class="tagline"
        >{content.footer.taglinePrefix}
        <a
          href="https://github.com/dm-balakin"
          target="_blank"
          rel="noreferrer noopener">Dmitrii Balakin</a
        ></span
      >
    </div>
    <div class="footer-project-links">
      <a
        href="https://github.com/balakin/autokpo"
        target="_blank"
        rel="noreferrer noopener"
        data-analytics-event="github_clicked"
        data-analytics-properties={JSON.stringify({ location: 'footer' })}
      >
        <span class="github-icon" aria-hidden="true"
          ><img class="github-black" src={githubBlackUrl} alt="" /><img
            class="github-white"
            src={githubWhiteUrl}
            alt=""
          /></span
        >
        GitHub
      </a>
      <span class="footer-license">AGPL-3.0</span>
    </div>
    <nav class="footer-legal-links" aria-label="Legal">
      <a
        href="mailto:support@autokpo.com"
        data-analytics-event="support_email_clicked">{content.support}</a
      >
      <span aria-hidden="true">·</span>
      <a href={legalUrls.terms}>{content.legalLinks.terms}</a>
      <span aria-hidden="true">·</span>
      <a href={legalUrls.privacy}>{content.legalLinks.privacy}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--separator);
    padding: 24px 0;
  }
  .site-footer a {
    text-decoration: none;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand project'
      'brand legal';
    gap: 6px 24px;
    align-items: center;
  }

  .footer-brand {
    grid-area: brand;
    display: flex;
    flex-direction: column;
    align-self: center;
  }
  .footer-brand .wordmark {
    font-size: 19px;
  }
  .footer-brand .tagline {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .footer-brand .tagline a {
    text-decoration: underline;
  }

  .footer-project-links {
    grid-area: project;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .footer-legal-links {
    grid-area: legal;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
  }

  .footer-project-links a,
  .footer-legal-links a {
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 120ms;
  }
  .footer-project-links a {
    font-size: 14px;
  }
  .footer-legal-links a {
    font-size: 13px;
  }
  .footer-project-links a:hover,
  .footer-legal-links a:hover {
    color: var(--foreground);
  }
  .footer-legal-links span {
    font-size: 13px;
    color: var(--muted);
  }

  .github-icon {
    position: relative;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    display: inline-block;
  }
  .github-icon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  .github-icon .github-white {
    display: none;
  }
  :global(.dark) .github-icon .github-black {
    display: none;
  }
  :global(.dark) .github-icon .github-white {
    display: block;
  }

  .footer-license {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    padding: 4px 10px;
    border-radius: 9999px;
    border: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand project'
        'legal legal';
      row-gap: 16px;
    }
    .footer-legal-links {
      justify-content: center;
    }
  }
</style>
