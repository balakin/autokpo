{
  "name": "autokpo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "i18n:extract": "pnpm --filter @autokpo/app i18n:extract",
    "generate:worker-types": "pnpm --filter @autokpo/app generate:worker-types",
    "check:worker-types": "pnpm --filter @autokpo/app check:worker-types",
    "auth:generate": "pnpm --filter @autokpo/app auth:generate",
    "db:generate": "pnpm --filter @autokpo/app db:generate",
    "db:migrate:local": "pnpm --filter @autokpo/app db:migrate:local",
    "db:migrate:remote": "pnpm --filter @autokpo/app db:migrate:remote",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "pnpm prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
