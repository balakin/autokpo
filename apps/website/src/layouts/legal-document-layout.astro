---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from './base-layout.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import { landingContent, supportedLocales } from '../i18n/landing';
import { legalContent, type LegalDocumentKey, type Locale } from '../i18n/legal';

type Props = {
  locale: Locale;
  documentKey: LegalDocumentKey;
  title?: string;
  description?: string;
  updated?: string;
};

const frontmatter = ((Astro.props as Props & { frontmatter?: Props }).frontmatter ?? Astro.props) as Props;
const { locale, documentKey, title, description, updated } = frontmatter;
const content = landingContent[locale];
const legalLocale = legalContent[locale];
const document = legalLocale.documents[documentKey];
const documentTitle = title ?? document.title;
const documentDescription = description ?? document.description;
const documentUpdated = updated ?? document.updated;
const formattedDate = new Date(documentUpdated).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
const homeUrl = getRelativeLocaleUrl(locale, '');
const legalUrls = {
  privacy: getRelativeLocaleUrl(locale, legalLocale.documents.privacy.slug),
  terms: getRelativeLocaleUrl(locale, legalLocale.documents.terms.slug),
};
const alternates = supportedLocales.map((alternateLocale) => ({
  locale: alternateLocale,
  route: getRelativeLocaleUrl(alternateLocale, document.slug),
  url: getAbsoluteLocaleUrl(alternateLocale, document.slug),
  languageName: landingContent[alternateLocale].languageName,
}));
---

<BaseLayout
  locale={locale}
  title={`${documentTitle} — AutoKPO`}
  description={documentDescription}
  skipLink={content.skipLink}
  themeLightLabel={content.theme.light}
  themeDarkLabel={content.theme.dark}
>
  <Fragment slot="head">
    <meta name="updated" content={documentUpdated} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(locale, document.slug)} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.url} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('sr-Latn', document.slug)} />
  </Fragment>

  <SiteHeader
    content={content}
    currentLocale={locale}
    homeHref={homeUrl}
    navPrefix={homeUrl}
    alternates={alternates}
  />

  <main id="main">
    <div class="legal-page">
      <div class="legal-meta">
        <span class="legal-updated">{legalLocale.ui.updatedPrefix}: {formattedDate}</span>
      </div>
      <article class="legal-content">
        <slot />
      </article>
    </div>
  </main>

  <SiteFooter content={content} legalUrls={legalUrls} />
</BaseLayout>

<style is:global>
  .legal-page { max-width: 880px; margin: 0 auto; padding: 52px 32px 88px; }
  .legal-meta {
    display: flex;
    align-items: center;
    margin-bottom: 4px;
    padding-bottom: 4px;
  }
  .legal-updated { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }

  .legal-content { color: var(--foreground); }
  .legal-content h1 {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 10px;
    text-wrap: balance;
  }
  .legal-content h2 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-top: 34px;
    margin-bottom: 12px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--separator);
  }
  .legal-content h3 {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .legal-content h4 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 28px;
    margin-bottom: 8px;
  }
  .legal-content h5 { font-size: 14px; font-weight: 600; margin-top: 24px; margin-bottom: 6px; }
  .legal-content h6 { font-size: 13px; font-weight: 600; color: var(--muted); margin-top: 20px; margin-bottom: 6px; }
  .legal-content p {
    font-size: 15.5px;
    line-height: 1.68;
    color: var(--muted);
    margin-bottom: 13px;
    text-wrap: pretty;
  }
  .legal-content strong { color: var(--foreground); font-weight: 600; }
  .legal-content em { font-style: italic; }
  .legal-content del { text-decoration: line-through; color: var(--muted); opacity: 0.7; }
  .legal-content a {
    color: var(--accent-soft-foreground);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
    transition: text-decoration-color 120ms;
  }
  .legal-content a:hover { text-decoration-color: currentColor; }
  .legal-content code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-secondary);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 6px;
    color: var(--foreground);
  }
  .legal-content pre {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px 20px;
    overflow-x: auto;
    margin: 20px 0;
    box-shadow: var(--surface-shadow);
  }
  .legal-content pre.astro-code {
    background: var(--surface) !important;
    color: var(--foreground) !important;
  }
  .legal-content pre.astro-code span {
    color: var(--foreground) !important;
  }
  .legal-content pre code {
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    font-size: 13px;
    line-height: 1.65;
    color: var(--foreground);
  }
  .legal-content blockquote {
    margin: 20px 0;
    padding: 14px 20px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
  .legal-content blockquote p {
    margin: 0;
    color: var(--accent-soft-foreground);
    font-size: 15px;
    line-height: 1.6;
  }
  .legal-content ul,
  .legal-content ol {
    padding-left: 24px;
    margin: 12px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .legal-content li { font-size: 15.5px; line-height: 1.65; color: var(--muted); }
  .legal-content li strong { color: var(--foreground); }
  .legal-content ul li::marker { color: var(--accent); }
  .legal-content ol li::marker { font-family: var(--font-mono); font-size: 13px; color: var(--accent); font-weight: 600; }
  .legal-content li > ul,
  .legal-content li > ol { margin: 6px 0 2px; }
  .legal-content hr { border: none; border-top: 1px solid var(--separator); margin: 24px 0; }
  .legal-content table {
    width: fit-content;
    max-width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 20px 0;
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
  .legal-content th {
    text-align: left;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-secondary);
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    max-width: 400px;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .legal-content td {
    padding: 11px 16px;
    border-bottom: 1px solid var(--separator);
    color: var(--muted);
    line-height: 1.5;
    max-width: 400px;
    white-space: normal;
    overflow-wrap: anywhere;
    vertical-align: top;
  }
  .legal-content tr:last-child td { border-bottom: none; }

  @media (max-width: 620px) {
    .wrap { padding: 0 18px; }
    .legal-page { padding: 36px 18px 72px; }
    .legal-content h1 { font-size: 24px; }
    .legal-content h2 { font-size: 18px; }
  }
</style>
