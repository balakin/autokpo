{
  "name": "@autokpo/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "analyze": "tsc -b && cross-env ANALYZE_BUNDLE=true vite build",
    "dev": "vite",
    "i18n:extract": "lingui extract --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "preview": "vite preview",
    "generate:worker-types": "wrangler types",
    "check:worker-types": "wrangler types --check",
    "emails:dev": "email dev",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config auth.config.ts --output worker/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@heroui/react": "^3.0.5",
    "@heroui/styles": "^3.0.5",
    "@hookform/resolvers": "^5.4.0",
    "@internationalized/date": "^3.12.1",
    "@lingui/core": "^6.1.0",
    "@lingui/react": "^6.1.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@react-pdf/renderer": "^4.5.1",
    "@react-spectrum/provider": "^3.11.0",
    "@tanstack/react-query": "^5.100.14",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hash-wasm": "^4.12.0",
    "hono": "^4.12.23",
    "react": "^19.2.6",
    "react-currency-input-field": "^4.0.5",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-email": "^6.3.2",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.6.0",
    "react-router": "^7.15.1",
    "react-transition-group": "^4.4.5",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "tailwind-variants": "^3.2.2",
    "use-sync-external-store": "^1.6.0",
    "workbox-window": "^7.4.1",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/vitest-pool-workers": "^0.16.6",
    "@lingui/babel-plugin-lingui-macro": "^6.0.1",
    "@lingui/cli": "^6.0.1",
    "@lingui/vite-plugin": "^6.0.1",
    "@react-email/ui": "^6.1.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "rolldown": "1.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}
