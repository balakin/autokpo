---
import {
  BookOpen,
  ChartColumn,
  ChevronRight,
  CodeXml,
  CreditCard,
  FileDown,
  FilePlusCorner,
  Lock,
  Moon,
  Sun,
  User,
} from '@lucide/astro';

import githubBlackUrl from '../assets/github-black.svg?url';
import githubWhiteUrl from '../assets/github-white.svg?url';
import { landingContent, localeAlternates, type IconName, type LandingContent } from '../i18n/landing';

type Props = {
  content: LandingContent;
};

const { content } = Astro.props;
const site = Astro.site ?? new URL('https://autokpo.com');
const canonicalUrl = new URL(content.route, site).toString();
const alternates = localeAlternates.map((alternate) => ({
  ...alternate,
  url: new URL(alternate.route, site).toString(),
}));

const iconByName = {
  book: BookOpen,
  chart: ChartColumn,
  code: CodeXml,
  creditCard: CreditCard,
  fileDown: FileDown,
  filePlus: FilePlusCorner,
  lock: Lock,
  user: User,
} satisfies Record<IconName, unknown>;
---

<!doctype html>
<html lang={content.locale} data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{content.meta.title}</title>
  <meta name="description" content={content.meta.description} />
  <link rel="canonical" href={canonicalUrl} />
  {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.url} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(landingContent['sr-Latn'].route, site).toString()} />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />

  <!-- Set theme before paint to avoid wrong-theme flash -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem("autokpo-theme");
        var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = saved || (prefersDark ? "dark" : "light");
        var root = document.documentElement;
        root.setAttribute("data-theme", theme);
        root.classList.toggle("dark", theme === "dark");
      } catch (e) {}
    })();
  </script>

  <style is:global>
    /* ── Fonts (local files, same as app) ──────────────────── */
    @font-face { font-family:"Manrope"; font-style:normal; font-weight:200 800; font-display:swap; src:url("/fonts/manrope/Manrope-VariableFont_wght.woff2") format("woff2"); }
    @font-face { font-family:"JetBrains Mono"; font-style:normal; font-weight:100 800; font-display:swap; src:url("/fonts/jetbrains-mono/JetBrainsMono-VariableFont_wght.woff2") format("woff2"); }

    /* ── Light theme ───────────────────────────────────────── */
    :root, [data-theme="light"] {
      --font-sans: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --background:        oklch(0.97  0.005 240);
      --surface:           oklch(0.995 0.003 240);
      --surface-secondary: oklch(0.96  0.004 240);
      --overlay:           oklch(0.995 0.003 240);
      --foreground:        oklch(0.2   0.015 260);
      --muted:             oklch(0.5   0.02  250);
      --default:           oklch(0.94  0.005 240);
      --default-foreground:oklch(0.2   0.015 260);
      --accent:            oklch(0.6   0.1   245);
      --accent-foreground: oklch(1     0     0);
      --accent-soft:       oklch(0.92  0.03  245);
      --accent-soft-foreground: oklch(0.3 0.03 245);
      --success:           oklch(0.55  0.1   155);
      --warning:           oklch(0.7   0.1   85);
      --danger:            oklch(0.6   0.12  25);
      --border:            oklch(0.88  0.008 240);
      --separator:         oklch(0.9   0.006 240);
      --focus:             var(--accent);
      --link:              var(--foreground);
      --surface-shadow:    0 2px 4px 0 rgba(0,0,0,.04), 0 1px 2px 0 rgba(0,0,0,.06), 0 0 1px 0 rgba(0,0,0,.06);
      --overlay-shadow:    0 4px 16px 0 rgba(24,24,27,.08), 0 8px 24px 0 rgba(24,24,27,.09);
      color-scheme: light;
    }

    /* ── Dark theme ────────────────────────────────────────── */
    .dark, [data-theme="dark"] {
      --background:        oklch(0.12  0.015 255);
      --surface:           oklch(0.16  0.012 255);
      --surface-secondary: oklch(0.2   0.01  255);
      --overlay:           oklch(0.18  0.012 255);
      --foreground:        oklch(0.95  0.005 260);
      --muted:             oklch(0.78  0.015 255);
      --default:           oklch(0.28  0.015 255);
      --default-foreground:oklch(0.95  0.005 260);
      --accent:            oklch(0.48  0.08  245);
      --accent-foreground: oklch(1     0     0);
      --accent-soft:       oklch(0.28  0.04  245);
      --accent-soft-foreground: oklch(0.85 0.02 245);
      --success:           oklch(0.72  0.12  155);
      --warning:           oklch(0.8   0.1   85);
      --danger:            oklch(0.65  0.12  25);
      --border:            oklch(0.28  0.015 255);
      --separator:         oklch(0.25  0.015 255);
      --surface-shadow:    0 0 0 0 transparent;
      --overlay-shadow:    0 0 1px 0 rgba(255,255,255,.08) inset;
      color-scheme: dark;
    }

    /* ── Reset / base ──────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.5;
      background: var(--background);
      color: var(--foreground);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    h1, h2, h3, p { margin: 0; }
    a {
      color: var(--link);
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-color: color-mix(in oklch, currentColor 30%, transparent);
    }
    a:hover { text-decoration-color: currentColor; }
    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
      border-radius: 6px;
    }
    button { font: inherit; cursor: pointer; }
    svg { flex-shrink: 0; }

    .skip-link {
      position: absolute; left: 12px; top: -48px;
      background: var(--surface); color: var(--foreground);
      padding: 8px 14px; border-radius: 10px;
      box-shadow: var(--surface-shadow); z-index: 100;
      text-decoration: none; transition: top 120ms;
    }
    .skip-link:focus { top: 12px; }

    /* ── Layout ────────────────────────────────────────────── */
    .wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .wordmark {
      font-weight: 700; font-size: 24px; line-height: 1;
      letter-spacing: -0.025em; color: var(--foreground);
      text-decoration: none; white-space: nowrap;
    }
    .wordmark:hover, .wordmark:visited, .wordmark:focus { color: var(--foreground); text-decoration: none; }

    /* ── Buttons (from app) ────────────────────────────────── */
    .btn {
      font-family: var(--font-sans); font-weight: 500; font-size: 14px;
      height: 38px; padding: 0 16px; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      border: none; box-shadow: var(--surface-shadow);
      transition: filter 120ms, background-color 120ms;
      white-space: nowrap; text-decoration: none;
    }
    .btn:hover { filter: brightness(0.96); text-decoration: none; }
    .btn:active { filter: brightness(0.92); }
    .btn.primary   { background: var(--accent);   color: var(--accent-foreground); }
    .btn.primary:visited { color: var(--accent-foreground); }
    .btn.secondary { background: var(--default);  color: var(--default-foreground); }
    .btn.secondary:visited { color: var(--default-foreground); }
    .btn svg { width: 16px; height: 16px; }
    .github-icon {
      position: relative; width: 16px; height: 16px; flex-shrink: 0;
      display: inline-block;
    }
    .github-icon img {
      position: absolute; inset: 0; width: 100%; height: 100%; display: block;
      object-fit: contain;
    }
    .github-icon .github-white { display: none; }
    .dark .github-icon .github-black { display: none; }
    .dark .github-icon .github-white { display: block; }
    .btn.lg { height: 44px; padding: 0 20px; font-size: 15px; }

    /* ── Header ────────────────────────────────────────────── */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: color-mix(in oklch, var(--background) 88%, transparent);
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--separator);
    }
    .header-inner { height: 60px; display: flex; align-items: center; gap: 16px; }
    .header-nav { display: flex; align-items: center; gap: 28px; margin-left: 24px; }
    .header-nav a {
      font-size: 14px; font-weight: 500; color: var(--muted);
      text-decoration: none; transition: color 120ms;
    }
    .header-nav a:hover { color: var(--foreground); }
    .header-spacer { flex: 1; }
    .header-actions { display: flex; align-items: center; gap: 8px; }

    .language-switcher {
      display: inline-flex; align-items: center; gap: 2px;
      height: 38px; padding: 3px; border-radius: 10px;
      background: var(--default); border: 1px solid var(--border);
      box-shadow: var(--surface-shadow);
    }
    .language-switcher a {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 34px; height: 30px; padding: 0 8px; border-radius: 8px;
      font-family: var(--font-mono); font-size: 11px; font-weight: 600;
      color: var(--muted); text-decoration: none;
      transition: background-color 120ms, color 120ms;
    }
    .language-switcher a:hover { color: var(--foreground); }
    .language-switcher a[aria-current="page"] {
      background: var(--surface); color: var(--foreground);
      box-shadow: 0 1px 2px rgba(0,0,0,.05);
    }

    .theme-toggle {
      width: 38px; height: 38px; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--default); color: var(--default-foreground);
      border: 1px solid var(--border); box-shadow: var(--surface-shadow);
      transition: filter 120ms;
    }
    .theme-toggle:hover { filter: brightness(0.96); }
    .theme-toggle svg { width: 17px; height: 17px; }
    .theme-toggle .i-sun { display: none; }
    .dark .theme-toggle .i-sun  { display: block; }
    .dark .theme-toggle .i-moon { display: none; }
    .hide-sm { }

    /* ── Section scaffolding ───────────────────────────────── */
    section { scroll-margin-top: 76px; }
    .eyebrow {
      font-family: var(--font-mono); font-size: 12px; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .eyebrow::before {
      content: ""; width: 18px; height: 1px; background: var(--border);
    }
    .section-head { max-width: 600px; margin-bottom: 40px; }
    .section-head .eyebrow { margin-bottom: 14px; }
    .section-head h2 {
      font-size: 26px; font-weight: 700; letter-spacing: -0.02em;
      line-height: 1.25; margin-bottom: 12px;
    }
    .section-head p { color: var(--muted); font-size: 16px; line-height: 1.55; }

    /* ── Hero ──────────────────────────────────────────────── */
    .hero { position: relative; padding: 88px 0 72px; overflow: hidden; }
    .hero::before { display: none; }
    .hero-grid {
      position: relative; z-index: 1;
      display: grid; grid-template-columns: 1fr 1.05fr;
      gap: 48px; align-items: center;
    }
    .hero-inner { max-width: 540px; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      height: 28px; padding: 0 12px 0 10px; border-radius: 9999px;
      background: var(--surface); border: 1px solid var(--border);
      box-shadow: var(--surface-shadow);
      font-size: 12.5px; font-weight: 500; color: var(--muted);
      margin-bottom: 32px; white-space: nowrap;
    }
    .hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); flex-shrink: 0; }
    .hero h1 {
      font-size: clamp(30px, 4.4vw, 42px);
      line-height: 1.14; font-weight: 700; letter-spacing: -0.025em;
      margin-bottom: 22px; text-wrap: balance;
    }
    .hero h1 .em { color: var(--accent-soft-foreground); }
    .hero-lede {
      font-size: 17px; line-height: 1.6; color: var(--muted);
      max-width: 560px; margin: 0 0 36px; text-wrap: pretty;
    }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

    /* ── Hero ledger card ──────────────────────────────────── */
    .ledger {
      position: relative; z-index: 1;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 14px; box-shadow: var(--overlay-shadow);
      overflow: hidden; font-feature-settings: "tnum" 1;
    }
    .ledger-head {
      display: flex; align-items: center; gap: 10px;
      padding: 14px 18px; border-bottom: 1px solid var(--separator);
      background: var(--surface-secondary);
    }
    .ledger-head .lh-title {
      font-size: 13px; font-weight: 600; letter-spacing: -0.01em;
    }
    .ledger-head .lh-spacer { flex: 1; }
    .ledger-head .lh-year {
      font-family: var(--font-mono); font-size: 12px; color: var(--muted);
      border: 1px solid var(--border); border-radius: 9999px; padding: 3px 10px;
    }
    .ledger-table { width: 100%; }
    .ledger-colhead {
      display: grid; grid-template-columns: 28px minmax(0,1fr) auto;
      gap: 12px; padding: 10px 18px;
      font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--muted);
      border-bottom: 1px solid var(--separator);
    }
    .ledger-colhead .num, .ledger-row .num { text-align: right; }
    .ledger-row {
      display: grid; grid-template-columns: 28px minmax(0,1fr) auto;
      gap: 12px; padding: 13px 18px; align-items: baseline;
      border-bottom: 1px solid var(--separator);
    }
    .ledger-row .rb { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
    .ledger-row .desc { font-family: var(--font-mono); font-size: 12.5px; color: var(--foreground); line-height: 1.35; }
    .ledger-row .desc small { display: block; font-family: var(--font-sans); font-size: 11.5px; color: var(--muted); margin-top: 3px; }
    .ledger-row .amt {
      font-family: var(--font-mono); font-size: 13px; font-weight: 500;
      color: var(--foreground); white-space: nowrap;
    }
    .ledger-total {
      display: grid; grid-template-columns: 1fr auto; gap: 12px;
      padding: 15px 18px; align-items: baseline; background: var(--surface-secondary);
    }
    .ledger-total .lt-label {
      font-size: 12px; font-weight: 600; letter-spacing: 0.02em;
      text-transform: uppercase; color: var(--muted);
    }
    .ledger-total .lt-amt {
      font-family: var(--font-mono); font-size: 16px; font-weight: 600;
      color: var(--foreground); white-space: nowrap;
    }

    /* ── Features ──────────────────────────────────────────── */
    .features { padding: 48px 0; }
    .feature-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    .feature-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; box-shadow: var(--surface-shadow);
      padding: 22px; display: flex; flex-direction: column; gap: 12px;
    }
    .feature-ico {
      width: 38px; height: 38px; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--accent-soft); color: var(--accent-soft-foreground);
    }
    .feature-ico svg { width: 19px; height: 19px; }
    .feature-card h3 { font-size: 15.5px; font-weight: 600; letter-spacing: -0.01em; }
    .feature-card p { font-size: 14px; line-height: 1.55; color: var(--muted); }

    /* ── Trust / Security ──────────────────────────────────── */
    .trust { padding: 48px 0; }
    .trust-inner {
      display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px;
      align-items: start;
    }
    .trust-list { display: flex; flex-direction: column; gap: 4px; }
    .trust-item {
      display: flex; gap: 16px; padding: 20px 0;
      border-bottom: 1px solid var(--separator);
    }
    .trust-item:last-child { border-bottom: none; }
    .trust-item .t-ico {
      width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--surface-secondary); color: var(--foreground);
      border: 1px solid var(--border);
    }
    .trust-item .t-ico svg { width: 17px; height: 17px; }
    .trust-item h3 { font-size: 15px; font-weight: 600; margin-bottom: 5px; letter-spacing: -0.01em; }
    .trust-item p { font-size: 14px; line-height: 1.55; color: var(--muted); }
    .trust-item .mono { font-family: var(--font-mono); font-size: 13px; color: var(--foreground); }

    /* ── FAQ ───────────────────────────────────────────────── */
    .faq { padding: 48px 0; }
    .faq-inner {
      display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px;
      align-items: start;
    }
    .faq-list { display: flex; flex-direction: column; }
    details.faq-item {
      border-bottom: 1px solid var(--separator);
    }
    details.faq-item:first-child { border-top: 1px solid var(--separator); }
    .faq-item summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; gap: 16px;
      padding: 20px 4px; font-size: 16px; font-weight: 600;
      letter-spacing: -0.01em; color: var(--foreground);
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary .q-mark {
      flex: 0 0 auto; width: 22px; height: 22px; border-radius: 6px;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--muted); transition: transform 160ms ease, color 120ms;
    }
    .faq-item summary .q-mark svg { width: 16px; height: 16px; }
    .faq-item[open] summary .q-mark { transform: rotate(90deg); color: var(--accent-soft-foreground); }
    .faq-item summary .q-text { flex: 1; }
    .faq-answer {
      padding: 0 4px 22px 54px; font-size: 14.5px; line-height: 1.6;
      color: var(--muted); max-width: 640px;
    }
    .faq-answer strong { color: var(--foreground); font-weight: 600; }
    .faq-note {
      margin-top: 0; font-size: 16px; line-height: 1.55; color: var(--muted);
    }

    /* ── Final CTA ─────────────────────────────────────────── */
    .final { padding: 20px 0 64px; }
    .final-card {
      position: relative; overflow: hidden;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 16px; box-shadow: var(--surface-shadow);
      padding: 52px 40px; text-align: center;
    }
    .final-card::before { display: none; }
    .final-card > * { position: relative; z-index: 1; }
    .final-card h2 { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }
    .final-card p { color: var(--muted); font-size: 16px; max-width: 460px; margin: 0 auto 28px; line-height: 1.55; }
    .final-card .hero-cta { justify-content: center; }

    /* ── Footer ────────────────────────────────────────────── */
    .site-footer { border-top: 1px solid var(--separator); padding: 36px 0; }
    .footer-inner {
      display: flex; align-items: center; gap: 16px 24px; flex-wrap: wrap;
    }
    .footer-brand { display: flex; flex-direction: column; gap: 6px; }
    .footer-brand .wordmark { font-size: 19px; }
    .footer-brand .tagline { font-size: 13px; color: var(--muted); }
    .footer-spacer { flex: 1; }
    .footer-links { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .footer-links a {
      font-size: 14px; color: var(--muted); text-decoration: none;
      display: inline-flex; align-items: center; gap: 7px; transition: color 120ms;
    }
    .footer-links a:hover { color: var(--foreground); }
    .footer-links a svg { width: 15px; height: 15px; }
    .footer-links .github-icon { width: 15px; height: 15px; }
    .footer-license {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--font-mono); font-size: 12px; color: var(--muted);
      padding: 4px 10px; border-radius: 9999px; border: 1px solid var(--border);
    }

    /* ── Responsive ────────────────────────────────────────── */
    @media (max-width: 860px) {
      .feature-grid { grid-template-columns: repeat(2, 1fr); }
      .trust-inner { grid-template-columns: 1fr; gap: 28px; }
      .faq-inner { grid-template-columns: 1fr; gap: 28px; }
      .hero-grid { grid-template-columns: 1fr; gap: 44px; }
      .hero-inner { max-width: 620px; }
      .ledger { max-width: 100%; }
      .header-nav { gap: 18px; margin-left: 14px; }
    }
    @media (max-width: 720px) {
      .header-nav { display: none; }
    }
    @media (max-width: 620px) {
      .wrap { padding: 0 18px; }
      .feature-grid { grid-template-columns: 1fr; }
      .hero { padding: 48px 0 40px; }
      .hero-cta .btn { flex: 1; }
      .ledger-colhead, .ledger-row {
        padding-left: 14px; padding-right: 14px;
      }
      .final-card { padding: 40px 22px; }
      .faq-answer { padding-left: 4px; }
      .footer-spacer { display: none; }
      .hide-sm { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; animation: none !important; }
    }
  </style>
</head>
<body data-theme-light-label={content.theme.light} data-theme-dark-label={content.theme.dark}>
  <a class="skip-link" href="#main">{content.skipLink}</a>

  <!-- ── Header ─────────────────────────────────────────────── -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href="#top">AutoKPO</a>
      <nav class="header-nav" aria-label={content.navLabel}>
        <a href="#features">{content.nav.features}</a>
        <a href="#security">{content.nav.security}</a>
        <a href="#faq">{content.nav.faq}</a>
      </nav>
      <div class="header-spacer"></div>
      <div class="header-actions">
        <nav class="language-switcher" aria-label={content.languageSwitcherLabel}>
          {alternates.map((alternate) => (
            <a
              href={alternate.route}
              aria-current={alternate.locale === content.locale ? 'page' : undefined}
              aria-label={alternate.locale === content.locale ? `${alternate.languageName} — ${content.languageSwitcherCurrent}` : alternate.languageName}
              title={alternate.locale === content.locale ? `${alternate.languageName} — ${content.languageSwitcherCurrent}` : alternate.languageName}
            >
              {alternate.locale === 'sr-Latn' ? 'SR' : alternate.locale.toUpperCase()}
            </a>
          ))}
        </nav>
        <button class="theme-toggle" id="themeToggle" type="button" aria-label={content.theme.toggle} aria-pressed="false">
          <Moon class="i-moon" aria-hidden="true" stroke-width={1.75} />
          <Sun class="i-sun" aria-hidden="true" stroke-width={1.75} />
        </button>
        <a class="btn primary hide-sm" href="https://app.autokpo.com" rel="noreferrer noopener">{content.links.app}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <span id="top"></span>

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-inner">
            <span class="hero-badge"><span class="dot"></span>{content.hero.badge}</span>
            <h1>{content.hero.titlePrefix}<span class="em">{content.hero.titleEmphasis}</span>{content.hero.titleSuffix}</h1>
            <p class="hero-lede">{content.hero.lede}</p>
            <div class="hero-cta">
              <a class="btn primary lg" href="https://app.autokpo.com" rel="noreferrer noopener">{content.links.app}</a>
              <a class="btn secondary lg" href="https://github.com/balakin/autokpo" rel="noreferrer noopener">
                <span class="github-icon" aria-hidden="true"><img class="github-black" src={githubBlackUrl} alt="" /><img class="github-white" src={githubWhiteUrl} alt="" /></span>
                {content.links.github}
              </a>
            </div>
          </div>
          <div class="ledger" aria-hidden="true">
            <div class="ledger-head">
              <span class="lh-title">{content.ledger.title}</span>
              <span class="lh-spacer"></span>
              <span class="lh-year">2026</span>
            </div>
            <div class="ledger-table">
              <div class="ledger-colhead">
                <span>{content.ledger.columns.number}</span>
                <span>{content.ledger.columns.description}</span>
                <span class="num">{content.ledger.columns.amount}</span>
              </div>
              {content.ledger.rows.map((row) => (
                <div class="ledger-row">
                  <span class="rb">{row.number}</span>
                  <span class="desc">{row.date}<small>{row.client}</small></span>
                  <span class="amt num">{row.amount}</span>
                </div>
              ))}
            </div>
            <div class="ledger-total">
              <span class="lt-label">{content.ledger.totalLabel}</span>
              <span class="lt-amt">{content.ledger.totalAmount}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Features ─────────────────────────────────────────── -->
    <section class="features" id="features">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">{content.features.eyebrow}</span>
          <h2>{content.features.title}</h2>
          <p>{content.features.body}</p>
        </div>
        <div class="feature-grid">
          {content.features.items.map((feature) => {
            const Icon = iconByName[feature.icon];
            return (
              <article class="feature-card">
                <span class="feature-ico"><Icon aria-hidden="true" stroke-width={1.75} /></span>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── Trust / Security ─────────────────────────────────── -->
    <section class="trust" id="security">
      <div class="wrap trust-inner">
        <div class="section-head" style="margin-bottom:0;">
          <span class="eyebrow">{content.trust.eyebrow}</span>
          <h2>{content.trust.title}</h2>
          <p>{content.trust.body}</p>
        </div>

        <div class="trust-list">
          {content.trust.items.map((item) => {
            const Icon = iconByName[item.icon];
            return (
              <div class="trust-item">
                <span class="t-ico"><Icon aria-hidden="true" stroke-width={1.75} /></span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────────────────────── -->
    <section class="faq" id="faq">
      <div class="wrap faq-inner">
        <div class="section-head">
          <span class="eyebrow">{content.faq.eyebrow}</span>
          <h2>{content.faq.title}</h2>
          <p class="faq-note">{content.faq.note}</p>
        </div>

        <div class="faq-list">
          {content.faq.items.map((item) => (
            <details class="faq-item">
              <summary>
                <span class="q-mark"><ChevronRight aria-hidden="true" stroke-width={2} /></span>
                <span class="q-text">{item.question}</span>
              </summary>
              <div class="faq-answer" set:html={item.answerHtml} />
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Final CTA ────────────────────────────────────────── -->
    <section class="final">
      <div class="wrap">
        <div class="final-card">
          <h2>{content.final.title}</h2>
          <p set:html={content.final.bodyHtml} />
          <div class="hero-cta">
            <a class="btn primary lg" href="https://app.autokpo.com" rel="noreferrer noopener">{content.links.app}</a>
            <a class="btn secondary lg" href="https://github.com/balakin/autokpo" rel="noreferrer noopener">
              <span class="github-icon" aria-hidden="true"><img class="github-black" src={githubBlackUrl} alt="" /><img class="github-white" src={githubWhiteUrl} alt="" /></span>
              {content.links.github}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ── Footer ─────────────────────────────────────────────── -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <span class="wordmark">AutoKPO</span>
        <span class="tagline">{content.footer.taglinePrefix} <a href="https://github.com/dm-balakin" rel="noreferrer noopener">Dmitrii Balakin</a></span>
      </div>
      <div class="footer-spacer"></div>
      <div class="footer-links">
        <a href="https://github.com/balakin/autokpo" rel="noreferrer noopener">
          <span class="github-icon" aria-hidden="true"><img class="github-black" src={githubBlackUrl} alt="" /><img class="github-white" src={githubWhiteUrl} alt="" /></span>
          GitHub
        </a>
        <span class="footer-license">AGPL-3.0</span>
      </div>
    </div>
  </footer>

  <!-- ── Theme toggle (only JS on the page) ─────────────────── -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var body = document.body;
      var btn = document.getElementById("themeToggle");
      function sync() {
        var isDark = root.getAttribute("data-theme") === "dark";
        btn.setAttribute("aria-pressed", String(isDark));
        btn.setAttribute("aria-label", isDark ? body.dataset.themeLightLabel : body.dataset.themeDarkLabel);
      }
      sync();
      btn.addEventListener("click", function () {
        var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        root.classList.toggle("dark", next === "dark");
        try { localStorage.setItem("autokpo-theme", next); } catch (e) {}
        sync();
      });
    })();
  </script>
</body>
</html>
