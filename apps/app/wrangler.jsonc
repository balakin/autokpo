// IMPORTANT: After any change to this file, run `pnpm generate:worker-types` to regenerate types.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autokpo-app",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/main.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autokpo-database-dev",
      "database_id": "PLACEHOLDER_SET_VIA_WRANGLER_D1_CREATE",
      "migrations_dir": "./worker/db/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SYNC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "E2EE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "EXCHANGE_RATES_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "RESEND_FROM_EMAIL": "AutoKPO <autokpo@resend.dev>",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "RESEND_API_KEY",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "autokpo-database",
          "database_id": "0cfdb800-3a81-4207-9951-daa8fc7ec2f3",
          "migrations_dir": "./worker/db/migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "SYNC_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "E2EE_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "EXCHANGE_RATES_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      "vars": {
        "APP_URL": "https://autokpo.com",
        "RESEND_FROM_EMAIL": "AutoKPO <autokpo@notify.autokpo.com>",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "RESEND_API_KEY",
          "TURNSTILE_SECRET_KEY",
        ],
      },
    },
  },
}
