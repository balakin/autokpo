{
  "name": "autokpo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "i18n:extract": "pnpm --filter @autokpo/app i18n:extract",
    "generate:worker-types": "pnpm --filter @autokpo/app generate:worker-types",
    "check:worker-types": "pnpm --filter @autokpo/app check:worker-types",
    "auth:generate": "pnpm --filter @autokpo/app auth:generate",
    "db:generate": "pnpm --filter @autokpo/app db:generate",
    "db:migrate:local": "pnpm --filter @autokpo/app db:migrate:local",
    "db:migrate:remote": "pnpm --filter @autokpo/app db:migrate:remote",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "pnpm prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:tooling",
    "@changesets/cli": "catalog:tooling",
    "@commitlint/cli": "catalog:tooling",
    "@commitlint/config-conventional": "catalog:tooling",
    "@commitlint/types": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "husky": "catalog:tooling",
    "jiti": "catalog:tooling",
    "lint-staged": "catalog:tooling",
    "prettier": "catalog:tooling",
    "prettier-plugin-astro": "catalog:",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
