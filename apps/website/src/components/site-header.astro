---
import { Moon, Sun } from '@lucide/astro';
import type { LandingContent } from '../i18n/landing';

interface Props {
  content: LandingContent;
  currentLocale: string;
  homeHref: string;
  /** Prefix for nav anchor links — "" for landing, "/" or "/en/" etc for legal pages */
  navPrefix?: string;
  alternates: Array<{ locale: string; route: string; languageName: string }>;
}

const { content, currentLocale, homeHref, navPrefix = '', alternates } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={homeHref}>AutoKPO</a>
    <nav class="header-nav" aria-label={content.navLabel}>
      <a href={`${navPrefix}#features`}>{content.nav.features}</a>
      <a href={`${navPrefix}#security`}>{content.nav.security}</a>
      <a href={`${navPrefix}#faq`}>{content.nav.faq}</a>
    </nav>
    <div class="header-spacer"></div>
    <div class="header-actions">
      <nav class="language-switcher" aria-label={content.languageSwitcherLabel}>
        {alternates.map((alternate) => (
          <a
            href={alternate.route}
            aria-current={alternate.locale === currentLocale ? 'page' : undefined}
            aria-label={alternate.locale === currentLocale ? `${alternate.languageName} — ${content.languageSwitcherCurrent}` : alternate.languageName}
            title={alternate.locale === currentLocale ? `${alternate.languageName} — ${content.languageSwitcherCurrent}` : alternate.languageName}
            data-analytics-event="language_switched"
            data-analytics-properties={JSON.stringify({ locale: alternate.locale })}
          >
            {alternate.locale === 'sr-Latn' ? 'SR' : alternate.locale.toUpperCase()}
          </a>
        ))}
      </nav>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label={content.theme.toggle} aria-pressed="false">
        <Moon class="i-moon" aria-hidden="true" stroke-width={1.75} />
        <Sun class="i-sun" aria-hidden="true" stroke-width={1.75} />
      </button>
      <a class="btn primary hide-sm" href="https://app.autokpo.com" rel="noreferrer noopener" data-analytics-event="app_opened" data-analytics-properties={JSON.stringify({ location: 'header' })}>{content.links.app}</a>
    </div>
  </div>
</header>

<style>
  /* Keep the sticky element itself background-free: iOS 26 Safari derives its
     toolbar tint from fixed/sticky elements at the viewport edge, and a
     translucent background (or border-bottom) breaks the sampling. The glass
     effect lives on an absolute ::before child, which Safari ignores, so the
     toolbar falls back to the theme-aware body background. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in oklch, var(--background) 88%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--separator);
  }
  .header-inner { height: 60px; display: flex; align-items: center; gap: 16px; }
  .header-nav { display: flex; align-items: center; gap: 28px; margin-left: 24px; }
  .header-nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 120ms;
  }
  .header-nav a:hover { color: var(--foreground); }
  .header-spacer { flex: 1; }
  .header-actions { display: flex; align-items: center; gap: 8px; }

  .wordmark {
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--foreground);
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover,
  .wordmark:visited,
  .wordmark:focus { color: var(--foreground); text-decoration: none; }

  .btn {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 14px;
    height: 38px;
    padding: 0 16px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: none;
    box-shadow: var(--surface-shadow);
    transition: filter 120ms, background-color 120ms;
    white-space: nowrap;
    text-decoration: none;
  }
  .btn:hover { filter: brightness(0.96); text-decoration: none; }
  .btn:active { filter: brightness(0.92); }
  .btn.primary { background: var(--accent); color: var(--accent-foreground); }
  .btn.primary:visited { color: var(--accent-foreground); }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 38px;
    padding: 3px;
    border-radius: 10px;
    background: var(--default);
    border: 1px solid var(--border);
    box-shadow: var(--surface-shadow);
  }
  .language-switcher a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 30px;
    padding: 0 8px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: background-color 120ms, color 120ms;
  }
  .language-switcher a:hover { color: var(--foreground); }
  .language-switcher a[aria-current="page"] {
    background: var(--surface);
    color: var(--foreground);
    box-shadow: 0 1px 2px rgba(0,0,0,.05);
  }

  .theme-toggle {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--default);
    color: var(--default-foreground);
    border: 1px solid var(--border);
    box-shadow: var(--surface-shadow);
    transition: filter 120ms;
  }
  .theme-toggle:hover { filter: brightness(0.96); }
  .theme-toggle svg { width: 17px; height: 17px; }
  .theme-toggle .i-sun { display: none; }
  :global(.dark) .theme-toggle .i-sun { display: block; }
  :global(.dark) .theme-toggle .i-moon { display: none; }

  .hide-sm { }

  @media (max-width: 860px) {
    .header-nav { gap: 18px; margin-left: 14px; }
  }
  @media (max-width: 720px) {
    .header-nav { display: none; }
  }
  @media (max-width: 620px) {
    .hide-sm { display: none; }
  }
</style>
